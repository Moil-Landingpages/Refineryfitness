# ---------------------------------------------------------------------------
# Refinery Fitness of Buda — environment
#
# Copy to `.env` (or `.env.local`) and fill in. `.env*` is gitignored; this
# example file is the only one committed.
#
#   cp .env.example .env
#
# Every value below is read on the SERVER only. Nothing here is prefixed with
# NEXT_PUBLIC_, so none of it reaches the browser bundle.
# ---------------------------------------------------------------------------


# --- Moil Email Gateway ----------------------------------------------------
# Both the free-intro form and the 90-second check-in post to /api/enquiry,
# which hands the message to the gateway (POST /emails/send). The gateway
# queues it and its worker delivers through the SMTP relay configured below,
# so a slow or briefly unreachable relay delays delivery instead of failing
# the visitor's submission.

# Base origin of the gateway. No trailing slash.
EMAIL_GATEWAY_URL=https://mail.moilapp.com

# This application's API key, issued by the gateway admin
# (POST /admin/applications). Shown once at creation — treat it as a secret.
EMAIL_GATEWAY_API_KEY=mg_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- SMTP relay ------------------------------------------------------------
# Credentials for the mailbox the gateway sends *as*. These are passed inline
# with each send (the gateway's `auth` block), which also keeps its stored copy
# of the mailbox current. For Gmail / Google Workspace this is an App Password
# generated at https://myaccount.google.com/apppasswords — NOT the account
# password, and 2-Step Verification must be on for that page to exist.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The mailbox that authenticates against the relay.
SMTP_USERNAME=jeff@refineryfitness.biz

# The 16-character App Password. Spaces are stripped, so either form works.
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# starttls (default) | tls | none
#   starttls -> port 587, upgrade in-band. Enforced, never opportunistic.
#   tls      -> port 465, TLS from the first byte.
#   none     -> rejected by the gateway for any non-loopback host.
SMTP_ENCRYPTION=starttls


# --- Addressing ------------------------------------------------------------
# Address the notification is sent FROM. Must be one the relay permits; on
# Gmail that means the authenticated mailbox or a verified alias. Defaults to
# SMTP_USERNAME when left unset.
MAIL_FROM=jeff@refineryfitness.biz

# Optional display name on the From header.
MAIL_FROM_NAME=Refinery Fitness Website

# Where enquiries land. Jeff reads this inbox.
MAIL_TO=jeff@refineryfitness.biz
